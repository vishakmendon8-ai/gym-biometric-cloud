# Built-in Biometric Backend Configuration (set once in Vercel / hosting env vars)
# Gym clients never have to fill in or maintain these fields inside the app.

VITE_BIOMETRIC_SERVER_URL=https://dream-gym-1.onrender.com
# Optional: set only if your biometric server requires a Bearer API secret
VITE_BIOMETRIC_API_SECRET=

# Optional terminal metadata overrides
VITE_BIOMETRIC_DEVICE_NAME=Main Entrance Secureye Terminal
VITE_BIOMETRIC_DEVICE_SN=102026020002110
VITE_BIOMETRIC_P2P_ID=BD77B4BE-3765DCD
VITE_BIOMETRIC_DEVICE_IP=192.168.1.101
