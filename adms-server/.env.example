# HTTP server port (use 8080 behind Nginx on port 80, or 80 directly on a dedicated VPS)
PORT=8080
HOST=0.0.0.0

# Database:
# - Set DATABASE_URL for production PostgreSQL (recommended):
#   DATABASE_URL=postgresql://adms_user:strong_password@localhost:5432/adms_db
# - Leave blank to use built-in SQLite at SQLITE_PATH for quick single-server deployment.
DATABASE_URL=
SQLITE_PATH=./data/adms.db

# Device Online/Offline threshold in seconds (device is Online if last_seen_at is within this window)
DEVICE_ONLINE_THRESHOLD_SEC=120

# ADMS Handshake Configuration
# TimeZone offset sent to the device (5.5 = India IST, 0 = UTC, etc.)
ADMS_TIMEZONE=5.5
ADMS_ERROR_DELAY=60
ADMS_DELAY=10
ADMS_TRANS_TIMES=00:00;14:05
ADMS_TRANS_INTERVAL=1
ADMS_TRANS_FLAG=1111000000
ADMS_REALTIME=1
ADMS_ENCRYPT=0

# Optional: Protect REST API endpoints (/api/*) with a Bearer token or x-api-key
# Leave blank during initial testing; set in production.
API_AUTH_TOKEN=

# Optional: Live sync every valid ADMS punch directly into your GymPro Firebase Cloud Firestore
# Provide EITHER a path to serviceAccountKey.json OR inline JSON string (e.g. from cloud secret manager)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=gym001-50a97
